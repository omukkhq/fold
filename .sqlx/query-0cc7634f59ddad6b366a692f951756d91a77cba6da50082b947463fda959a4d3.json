  "query": "SELECT t.number AS \"number!: i64\", t.title, t.created_at\n           FROM tasks t\n           WHERE t.status = 'todo' AND t.archived_at IS NULL\n             AND NOT EXISTS (\n                 SELECT 1 FROM claims c\n                 WHERE c.task_id = t.id AND c.kind = 'implementation' AND c.released_at IS NULL\n             )\n           ORDER BY t.number",
