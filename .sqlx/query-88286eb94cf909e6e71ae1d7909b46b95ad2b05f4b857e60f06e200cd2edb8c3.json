  "query": "SELECT t.number AS \"number!: i64\", l.name, l.color, l.created_at\n           FROM task_labels tl\n           JOIN tasks t ON t.id = tl.task_id\n           JOIN labels l ON l.id = tl.label_id\n           WHERE t.archived_at IS NULL\n           ORDER BY t.number, l.name",
