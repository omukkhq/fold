{
  "db_name": "SQLite",
  "query": "SELECT m.number, m.thread_id, m.reply_to, m.sender_kind, w.name AS \"worker?: String\",\n                  m.sender_human, t.number AS \"task?: i64\", p.number AS \"proposal?: i64\",\n                  m.body, m.created_at\n           FROM messages m\n           LEFT JOIN workers w ON w.id = m.sender_worker_id\n           LEFT JOIN tasks t ON t.id = m.task_id\n           LEFT JOIN proposals p ON p.id = m.proposal_id\n           WHERE m.thread_id = ?\n           ORDER BY m.number",
