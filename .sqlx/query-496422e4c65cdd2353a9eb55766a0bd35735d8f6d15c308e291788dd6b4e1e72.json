  "query": "SELECT p.author_worker_id, p.number AS \"number!: i64\", t.number AS \"task!: i64\",\n                  p.title, p.conflicted AS \"conflicted: bool\"\n           FROM proposals p\n           JOIN tasks t ON t.id = p.task_id\n           WHERE p.state = 'open'\n           ORDER BY p.number",
