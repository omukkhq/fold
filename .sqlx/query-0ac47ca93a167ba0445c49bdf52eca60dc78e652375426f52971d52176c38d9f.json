  "query": "SELECT t.number AS \"task!: i64\", r.worker_id, w.name AS worker, r.note, r.created_at,\n                  r.resolution, r.resolved_by, r.resolved_at, r.send_back_note\n           FROM task_reports r\n           JOIN tasks t ON t.id = r.task_id\n           JOIN workers w ON w.id = r.worker_id\n           WHERE t.number = ?1\n           ORDER BY r.id DESC\n           LIMIT ?2",
